---
import "../styles/global.css";
import "../styles/docker.css";
import { Font } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Docker Hero Study — Edgar Alvarez",
  description = "A design study that recreates the hero and navbar of docker.com with Astro, Tailwind CSS and a procedural canvas particle field.",
} = Astro.props;

const base = import.meta.env.BASE_URL || "/";
const baseUrl = base.endsWith("/") ? base : `${base}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Edgar Alvarez" />
    <meta name="theme-color" content="#101010" />
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />

    <Font cssVariable="--font-docker-display" preload />
    <Font cssVariable="--font-docker-body" preload />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body class="dk-page">
    <a class="dk-skip" href="#dk-main">Skip to main content</a>
    <slot />
  </body>
</html>
