---
import type { Lang } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  name?: string;
  lang?: Lang;
}

const { name = 'Alexander Carter', lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<footer class="flex flex-col md:flex-row items-center justify-between gap-2 md:gap-0 px-4 md:px-12 py-5 border-t border-line font-mono text-[0.66rem] text-t3 tracking-wider text-center">
  <span>© 2026 {name}</span>
  <span class="text-o">Full Stack · Cloud · Systems</span>
  <span>{t.footer.builtWith} {t.footer.astro}, {t.footer.and} {t.footer.tailwind}</span>
</footer>
