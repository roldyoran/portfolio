---
import ButtonGroup from "@/components/button-group.astro";
import type { Project } from "@/data/types";
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";
import { techIcons } from "@/data/content";

interface Props {
  projects: Project[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL || "/";
function buildImageSrc(imgPath: string) {
  if (!imgPath) return imgPath;
  const baseNorm = base.endsWith("/") ? base.slice(0, -1) : base;
  if (!imgPath.startsWith("/")) {
    if (baseNorm === "/" || baseNorm === "") return `/${imgPath}`;
    return `${baseNorm}/${imgPath}`;
  }
  if (baseNorm === "/" || baseNorm === "") return imgPath;
  if (imgPath.startsWith(baseNorm + "/")) return imgPath;
  return `${baseNorm}${imgPath}`;
}

---

<section id="projects" class="section-inner py-10 md:py-14">
  <div class="reveal-hidden flex flex-wrap items-end justify-between gap-3 mb-6 md:mb-8">
    <div>
      <h2 class="font-big text-[clamp(2.2rem,6vw,4rem)] leading-none text-t1">
        {t.projects.title} {t.projects.subtitle}
      </h2>
    </div>
    <p class="font-mono text-[0.7rem] text-t3 tracking-widest uppercase">
      {projects.filter((p) => p.demo).length} {lang === "es" ? "en vivo" : "live"} · {projects.length} {lang === "es" ? "destacados" : "featured"}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
    {
      projects.map((project, index) => {
        const topTech = project.tech.slice(0, 4);
        const primaryHref = project.demo ?? project.github;
        const primaryLabel = project.demo ? t.projects.liveDemo : t.projects.architecture;
        return (
          <article class="bento-card reveal-hidden group flex flex-col !p-0 overflow-hidden">
            <div class="relative h-44 overflow-hidden">
              {project.image ? (
                <>
                  <img
                    src={buildImageSrc(project.image)}
                    alt={`${project.name} screenshot`}
                    loading="lazy"
                    class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-bg2 via-bg2/20 to-transparent" />
                </>
              ) : (
                <div class="absolute inset-0 bg-gradient-to-br from-bg3 via-bg2 to-white/5" />
              )}
              <div class="absolute top-3 left-3 flex items-center gap-2">
                <span class="font-mono text-[0.62rem] tracking-widest text-t3 bg-bg/80 backdrop-blur px-2 py-1 rounded-full border border-line">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {project.demo && (
                  <span data-tip={lang === "es" ? "Desplegado y respondiendo" : "Deployed and responding"} data-tip-pos="below" class="inline-flex items-center gap-1.5 font-mono text-[0.62rem] tracking-widest uppercase text-green-400 bg-bg/80 backdrop-blur px-2 py-1 rounded-full border border-line">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse" aria-hidden="true" />
                    {lang === "es" ? "En vivo" : "Live"}
                  </span>
                )}
              </div>
            </div>

            <div class="flex flex-col gap-3 p-5 flex-1">
              <h3 class="font-big text-[1.7rem] leading-none tracking-wide text-t1">
                {lang === "es" && project.nameEs ? project.nameEs : project.name}
              </h3>
              <p class="text-[0.85rem] text-t2/90 leading-relaxed">
                {lang === "es" && project.taglineEs ? project.taglineEs : project.tagline}
              </p>
              <ul class="flex flex-wrap gap-x-1.5 gap-y-2 mt-auto pt-1">
                {topTech.map((techItem) => {
                  const Icon = techIcons[techItem];
                  return (
                    <li class="chip inline-flex items-center gap-1.5">
                      {Icon ? <Icon size={14} class="block h-3.5 w-3.5 opacity-70" /> : null}
                      {techItem}
                    </li>
                  );
                })}
              </ul>
              <div class="flex items-center gap-3 pt-2 border-t border-line mt-1">
                <ButtonGroup
                  variant="primary"
                  size="sm"
                  href={primaryHref ?? "#"}
                  target="_blank"
                  rel="noopener"
                  iconRight="external"
                  label={primaryLabel}
                  class="font-bold"
                />
                {project.demo && project.github && (
                  <ButtonGroup
                    variant="ghost"
                    size="sm"
                    href={project.github}
                    target="_blank"
                    rel="noopener"
                    iconLeft="github"
                    label={t.projects.readCode}
                    ariaLabel={lang === "es" ? "Ver código en GitHub" : "View code on GitHub"}
                    class="code-btn font-bold"
                  />
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .code-btn {
    transition: transform 0.25s ease, border-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .code-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(249, 115, 22, 0.5);
    color: var(--color-o2);
    background: rgba(249, 115, 22, 0.07);
    box-shadow: 0 8px 20px rgba(249, 115, 22, 0.18);
  }

  @media (prefers-reduced-motion: reduce) {
    .code-btn:hover {
      transform: none;
    }
  }
</style>
