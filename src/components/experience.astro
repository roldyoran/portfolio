---
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";
import { techIcons } from "@/data/content";
import { ExternalLink } from "@lucide/astro";

interface Experience {
  id: number;
  company: string;
  location: string;
  role: string;
  roleEs?: string;
  period: { start: string; startEs?: string; end: string; endEs?: string };
  description: string;
  descriptionEs?: string;
  tech: string[];
  link?: string;
}

interface Props {
  experience: Experience[];
  lang: Lang;
}

const { experience, lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="border-b border-line section-inner">
  <div
    class="section-header reveal-hidden flex-col md:flex-row md:items-baseline md:justify-between text-center md:text-left"
  >
    <span class="sec-num">[ 02 ]</span>
    <h2 class="sec-title text-center md:text-left mt-2 md:mt-0 md:ml-4">
      {t.experience.title}<br />{t.experience.subtitle}
    </h2>
    <p class="sec-desc md:text-right mt-2 md:mt-0" set:html={t.experience.desc} />
  </div>

  {
    experience.map((exp, index) => (
      <div class="reveal-hidden exp-row relative px-4 md:px-12 py-6 md:py-8 border-t border-line overflow-hidden">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 md:gap-8">
          <div class="flex items-start gap-3 md:gap-4 md:min-w-[280px] lg:min-w-[320px]">
            <div class="flex-1 min-w-0">
              <div class="font-big text-[1.6rem] md:text-[2rem] leading-none tracking-wider">
                {lang === "es" && exp.roleEs ? exp.roleEs : exp.role}
              </div>
              <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 mt-1.5">
                <span class="text-[0.95rem] font-semibold text-t1">{exp.company}</span>
                <span class="text-t3 text-[0.7rem]">·</span>
                <span class="font-mono text-[0.78rem] text-o2 tracking-wider">{exp.location}</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col md:items-end md:shrink-0 md:pt-0.5 gap-1.5">
            <span class="font-mono text-[0.78rem] text-t3 tracking-wider whitespace-nowrap">
              {lang === "es" && exp.period.startEs ? exp.period.startEs : exp.period.start} —{" "}
              {lang === "es" && exp.period.endEs ? exp.period.endEs : exp.period.end}
            </span>
            {exp.link ? (
              <a
                href={exp.link}
                target="_blank"
                rel="noopener"
                class="exp-docs-link inline-flex items-center gap-1 font-mono text-[0.7rem] text-t3 tracking-wider hover:text-o transition-colors duration-200"
              >
                <ExternalLink size={12} />
                <span>{t.experience.docs}</span>
              </a>
            ) : null}
          </div>
        </div>

        <div class="mt-3 md:mt-4 ">
          <p class="text-[0.92rem] md:text-[0.95rem] text-t2 leading-relaxed">
            {lang === "es" && exp.descriptionEs ? exp.descriptionEs : exp.description}
          </p>
          <div class="flex gap-1.5 flex-wrap mt-2.5">
            {exp.tech.map((techItem) => {
              const Icon = techIcons[techItem];
              return (
                <span class="chip inline-flex items-center gap-1.5">
                  {Icon ? <Icon size={14} class="block h-3.5 w-3.5 opacity-40" /> : null}
                  {techItem}
                </span>
              );
            })}
          </div>
        </div>
      </div>
    ))
  }
</section>

<style>
  .exp-row {
    transition: background 0.5s ease;
  }

  .exp-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background: linear-gradient(to right, rgba(249, 115, 22, 0.1), transparent);
    transition: width 0.7s ease;
    z-index: 0;
    pointer-events: none;
  }

  .exp-row:hover::before {
    width: 100%;
  }

  .exp-row:hover {
    background: var(--color-bg2);
  }

  .exp-docs-link {
    position: relative;
    z-index: 20;
  }
</style>
