---
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";
import { techIcons } from "@/data/content";
import { bentoIcons } from "@/data/icon-map";

interface Experience {
  id: number;
  company: string;
  location: string;
  role: string;
  roleEs?: string;
  period: { start: string; startEs?: string; end: string; endEs?: string };
  description: string;
  descriptionEs?: string;
  tech: string[];
  link?: string;
}

interface Props {
  experience: Experience[];
  lang: Lang;
}

const { experience, lang } = Astro.props;
const t = useTranslations(lang);
const WorkIcon = bentoIcons.work;
const ArrowIcon = bentoIcons.arrowUpRight;
---

<section id="experience" class="section-inner py-10 md:py-14">
  <div class="reveal-hidden mb-6 md:mb-8">
    <h2 class="font-big text-[clamp(2.2rem,6vw,4rem)] leading-none text-t1">
      {t.experience.title} {t.experience.subtitle}
    </h2>
  </div>

  <div class="grid grid-cols-1 gap-3 md:gap-4">
    {
      experience.map((exp) => (
        <article class="bento-card reveal-hidden flex flex-col md:flex-row gap-5 md:gap-8 md:items-start">
          <span class="icon-chip"><WorkIcon size={18} /></span>
          <div class="flex-1 min-w-0">
            <h3 class="font-big text-[1.7rem] md:text-[2rem] leading-none tracking-wide text-t1">
              {lang === "es" && exp.roleEs ? exp.roleEs : exp.role}
            </h3>
            <p class="mt-1.5 font-mono text-[0.72rem] tracking-wider text-t2">
              {exp.company} · {exp.location}
            </p>
            <p class="mt-3 text-[0.9rem] text-t2/90 leading-relaxed max-w-2xl">
              {lang === "es" && exp.descriptionEs ? exp.descriptionEs : exp.description}
            </p>
            <ul class="flex flex-wrap gap-x-1.5 gap-y-2 mt-4">
              {exp.tech.slice(0, 5).map((techItem) => {
                const Icon = techIcons[techItem];
                return (
                  <li class="chip inline-flex items-center gap-1.5">
                    {Icon ? <Icon size={14} class="block h-3.5 w-3.5 opacity-70" /> : null}
                    {techItem}
                  </li>
                );
              })}
            </ul>
          </div>
          <div class="flex md:flex-col items-center md:items-end gap-2 md:text-right shrink-0">
            <span class="font-mono text-[0.7rem] text-t3 tracking-widest whitespace-nowrap">
              {lang === "es" && exp.period.startEs ? exp.period.startEs : exp.period.start} ·{" "}
              {lang === "es" && exp.period.endEs ? exp.period.endEs : exp.period.end}
            </span>
            {exp.link && (
              <a
                href={exp.link}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1 font-mono text-[0.68rem] tracking-widest uppercase text-t3 hover:text-t1 transition-colors"
              >
                {t.experience.docs} <ArrowIcon size={13} />
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
