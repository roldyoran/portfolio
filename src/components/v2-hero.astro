---
import HeroLogos from "@/components/hero-logos.astro";
import type { Hero } from "@/data/types";
import type { Lang } from "@/i18n/config";

interface Props {
  hero: Hero;
  lang: Lang;
  logosLabel: string;
  logoItems: string[];
  pinnedItems?: string[];
}

const { hero, lang, logosLabel, logoItems, pinnedItems = [] } = Astro.props;
const summary = lang === "es" ? hero.descriptionEs : hero.description;
---

<section id="home" class="v2-hero" data-v2-hero aria-labelledby="v2-hero-title">
  <canvas class="v2-hero__particles" data-v2-particles aria-hidden="true"></canvas>

  <div class="v2-hero__grid">
    <div class="v2-hero__copy">
      <h1 class="v2-hero__title" id="v2-hero-title">
        <span class="v2-hero-anim" style="--d: 0.05s">{hero.namePrimary}</span>
        <span class="v2-hero-anim" style="--d: 0.2s">
          <span class="v2-hero__title-soft">{hero.nameAccent}</span>
        </span>
      </h1>

      <div class="v2-hero__side">
        <p class="v2-hero__sub v2-hero-anim" style="--d: 0.38s">{summary}</p>
      </div>
    </div>

    <div class="v2-hero__zone" data-v2-zone></div>
  </div>

  <div class="v2-hero__logos">
    <HeroLogos
      items={logoItems}
      pinned={pinnedItems}
      tone="mono"
      tall
      cells={5}
      columns={5}
      iconSize={64}
    />
    <p class="sr-only">{logosLabel}</p>
  </div>
</section>

<script>
  import { initV2Hero } from "@/scripts/v2-hero";

  initV2Hero();
</script>

<style>
  .v2-hero {
    --v2-hero-h: calc(max(620px, 62svh) + 96px - 98px);
    --v2-logo-h: 96px;
    --v2-grid-margin: 48px;

    position: sticky;
    top: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    height: var(--v2-hero-h);
    padding-top: calc(68px + 98px);
    overflow: hidden;
    border-bottom-right-radius: 48px;
    border-bottom-left-radius: 48px;
    background: var(--color-ink);
    color: var(--color-cream);
  }

  .v2-hero__particles {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    color: var(--color-cream);
    opacity: 0;
    pointer-events: none;
    -webkit-mask-image:
      linear-gradient(to bottom, #000 0, #000 58%, transparent 100%),
      linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to bottom, #000 0, #000 58%, transparent 100%),
      linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
    mask-composite: intersect;
    transition: opacity 0.6s ease-out;
  }

  .v2-hero__particles.is-ready {
    opacity: 1;
  }

  .v2-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    flex: 1;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: minmax(0, 1fr);
    align-items: start;
    width: 100%;
    max-width: 1440px;
    min-height: 0;
    margin: 0 auto var(--v2-logo-h);
    padding: 0 var(--v2-grid-margin);
    column-gap: 32px;
    row-gap: 48px;
  }

  .v2-hero__copy {
    position: relative;
    z-index: 3;
    top: -64px;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px 32px;
    align-self: center;
    align-items: center;
  }

  .v2-hero__title {
    grid-area: 1 / 1 / auto / span 7;
    margin: 0;
    padding-bottom: 0.1em;
    color: var(--color-cream);
    font-family: var(--font-display);
    font-size: clamp(64px, 12vw, 132px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.04;
  }

  .v2-hero__title > span {
    display: block;
  }

  .v2-hero__title-soft {
    color: var(--color-soft-ink);
    font-weight: 300;
  }

  .v2-hero__side {
    display: flex;
    grid-area: 1 / 9 / auto / -1;
    flex-direction: column;
    align-self: center;
    align-items: flex-end;
    gap: 24px;
    text-align: right;
  }

  .v2-hero__sub {
    margin: 0;
    color: var(--color-cream);
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: 300;
    line-height: 1.5;
  }

  .v2-hero__zone {
    --v2-art-scale: 1.2;
    --v2-art-base: min(calc(var(--v2-hero-h) - var(--v2-logo-h)), 1100px);

    position: absolute;
    top: calc(50% - var(--v2-art-base) * var(--v2-art-scale) / 2);
    left: calc(50% - var(--v2-art-base) * var(--v2-art-scale) / 2);
    z-index: 1;
    width: calc(var(--v2-art-base) * var(--v2-art-scale));
    aspect-ratio: 1;
    transform-origin: 50% 50%;
    will-change: transform;
    animation: v2-zone-in 2.4s var(--ease-site) backwards;
  }

  @keyframes v2-zone-in {
    from {
      transform: translateY(-24px) scale(1.9);
    }

    to {
      transform: translateY(0) scale(1);
    }
  }

  .v2-hero__logos {
    position: absolute;
    right: 64px;
    bottom: 40px;
    left: 64px;
    z-index: 2;
  }

  /* Entrada réplica Docker 1:1 — desde arriba, 0.8s, retardos con --d */
  .v2-hero-anim {
    opacity: 0;
    animation: v2-hero-in 0.8s var(--ease-site) var(--d, 0s) both;
  }

  @keyframes v2-hero-in {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1365px) {
    .v2-hero__zone {
      --v2-art-scale: 1.1;
    }
  }

  @media (max-width: 1023px) {
    .v2-hero {
      --v2-grid-margin: 40px;
    }

    .v2-hero__copy {
      top: 0;
      align-items: start;
    }

    .v2-hero__title {
      grid-column: 1 / -1;
    }

    .v2-hero__side {
      grid-area: 2 / 1 / auto / -1;
      align-items: flex-start;
      text-align: left;
    }

    .v2-hero__zone {
      --v2-art-scale: 1;
    }
  }

  @media (max-width: 767px) {
    .v2-hero {
      --v2-grid-margin: 28px;
    }

    .v2-hero__sub {
      font-size: 20px;
    }
  }

  @media (max-width: 599px) {
    .v2-hero {
      --v2-hero-h: calc(min(max(560px, 72svh), 640px) + 96px - 98px);
      --v2-grid-margin: 20px;

      padding-top: calc(68px + 56px);
    }

    .v2-hero__grid {
      row-gap: 32px;
    }

    .v2-hero__copy {
      gap: 20px 24px;
    }

    .v2-hero__sub {
      font-size: 19px;
      line-height: 1.55;
    }

    .v2-hero__zone {
      --v2-art-scale: 1;

      top: calc(50% - 50vw);
      left: calc(50% - 50vw);
      width: 100vw;
    }

    .v2-hero__logos {
      right: 32px;
      left: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-hero-anim {
      opacity: 1;
      animation: none;
      transform: none;
    }

    .v2-hero__zone {
      animation: none;
    }

    .v2-hero__particles {
      transition: none;
    }
  }
</style>
