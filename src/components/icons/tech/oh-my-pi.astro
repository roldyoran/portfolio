---
interface Props {
  size?: number;
  class?: string;
}

const { size = 18, class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  {...Astro.props}
>
  <path d="M4 7h16"></path>
  <path d="M9 7v9.5c0 1.3-.3 2.4-.9 3.2"></path>
  <path d="M15 7v9.5c0 1.3.3 2.4.9 3.2"></path>
</svg>
