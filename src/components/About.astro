---
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";
import type { SkillWithIcon } from "@/data/types";
import { categories } from "@/data/content";

interface Props {
  skillsWithIcons: SkillWithIcon[];
  lang: Lang;
  bio: { text: string; textEs?: string }[];
}

const { skillsWithIcons, lang, bio } = Astro.props;
const t = useTranslations(lang);

const skillsByCategory = categories.reduce(
  (acc, cat) => {
    acc[cat] = skillsWithIcons.filter((s) => s.category === cat);
    return acc;
  },
  {} as Record<string, SkillWithIcon[]>,
);
---

<section id="about" class="border-b border-line">
  <div class="section-header reveal-hidden flex-col md:flex-row md:items-baseline md:justify-between text-center md:text-left">
    <span class="sec-num">[ 04 ]</span>
    <h2 class="sec-title mt-2 md:mt-0 md:ml-4">{t.about.title}</h2>
  </div>

  <div class="about-split grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr]">
    <div class="about-left reveal-hidden px-6 md:px-8 py-6 md:py-10 pb-8 md:pb-12 border-r-0 md:border-r border-line">
      {bio.map((paragraph) => (
        <p
          class="text-[0.95rem] md:text-[1rem] text-t2 leading-relaxed mb-6 max-w-full md:max-w-[480px]"
          set:html={lang === "es" && paragraph.textEs ? paragraph.textEs : paragraph.text}
        />
      ))}
    </div>

    <div class="about-right mt-6 md:mt-0 px-4 md:px-0 md:pl-6 pr-4 md:pr-8">
      <div class="reveal-hidden skills-grid md:mt-0 grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 px-2 md:px-0">
        {categories.map((category) => {
          const categorySkills = skillsByCategory[category] || [];
          if (categorySkills.length === 0) return null;
          return (
            <section class="skill-category mb-2">
              <details class="md:block" open>
                <summary class="flex items-center justify-between md:static md:mb-2 md:cursor-default">
                  <span class="font-mono text-[0.6rem] text-o tracking-widest uppercase">{t.about.categories[category] ?? category}</span>
                  <span class="md:hidden font-mono text-[0.6rem] text-t3">{categorySkills.length}</span>
                </summary>
                <div class="chips mt-2 grid grid-cols-2 md:grid-cols-2 lg:grid-cols-1 gap-1.5 md:gap-2">
                  {categorySkills.map((skill) => {
                    const Icon = skill.icon;
                    const iconProps = skill.iconProps;
                    return (
                      <div
                        class="skill-item flex items-center md:justify-start justify-center gap-2 px-2 py-1 bg-white/[0.03] rounded-sm border border-white/[0.04] text-[0.75rem] text-t2 transition-colors duration-150 hover:bg-white/[0.06] hover:border-o/30"
                        aria-label={skill.name}
                      >
                        {Icon ? (
                          <Icon {...iconProps} />
                        ) : (
                          <span class="w-4 h-4 rounded bg-o/20 text-[0.6rem] flex items-center justify-center text-o">
                            {skill.name.charAt(0)}
                          </span>
                        )}
                        <span class="hidden md:inline">{skill.name}</span>
                      </div>
                    );
                  })}
                </div>
              </details>
            </section>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .about-stat-block::before {
    content: "";
    position: absolute;
    right: -30px;
    top: 50%;
    transform: translateY(-50%);
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 92, 26, 0.07) 0%, transparent 70%);
  }
</style>
