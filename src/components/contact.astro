---
import ButtonGroup from "@/components/button-group.astro";
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";
import { Mail, MapPin, ArrowUpRight } from "@lucide/astro";

interface Props {
  email?: string;
  social?: {
    github?: string;
    linkedin?: string;
    twitter?: string;
  };
  lang: Lang;
}

const { email = "#", social = {}, lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL || '/';
const baseUrl = base.endsWith('/') ? base : `${base}/`;
const cvUrl = `${baseUrl}cv/CV_Edgar_Alvarez.pdf`;

const contactInfo = lang === "es"
  ? { location: "San Miguel Petapa, Guatemala", availability: "Disponible para proyectos freelance y tiempo completo" }
  : { location: "San Miguel Petapa, Guatemala", availability: "Available for freelance and full-time roles" };
---

<script>
  import "@/scripts/download-cv";
</script>

<section id="contact" class="relative overflow-hidden border-b border-line section-inner py-20 md:py-28">
  <!-- Top border accent -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-o/30 to-transparent"></div>

  <!-- Background watermark -->
  <div
    class="absolute bottom-0 right-0 text-[clamp(80px,18vw,280px)] leading-none text-transparent pointer-events-none select-none z-0"
    style="-webkit-text-stroke: 1px rgba(255,255,255,0.025); letter-spacing: 0.04em;"
    aria-hidden="true"
  >
    {lang === "es" ? "HOLA" : "HELLO"}
  </div>

  <!-- Subtle radial glow behind content -->
  <div class="absolute inset-0 pointer-events-none z-0"   style="background: radial-gradient(ellipse 60% 50% at 70% 60%, rgba(249,115,22,0.04), transparent);" aria-hidden="true"></div>

  <!-- Section header -->
  <div class="reveal-hidden section-header flex-col md:flex-row md:items-baseline md:justify-between text-center md:text-left">
    <span class="sec-num">[ 05 ]</span>
    <h2 class="sec-title text-center md:text-left mt-2 md:mt-0 md:ml-4">
      {t.contact.title}
      {t.contact.subtitle ? <><br />{t.contact.subtitle}</> : null}
      <br />
      <span class="text-o">{t.contact.highlight}</span>
    </h2>
    <div class="mt-4 md:mt-0 flex flex-col gap-3 w-full max-w-xl ml-auto">
      <div class="flex gap-2 w-full">
        <ButtonGroup
          variant="primary"
          copyEmail={true}
          email={email}
          iconLeft="mail"
          label={t.hero.copyEmail}
          ariaLabel={lang === "es" ? "Copiar correo electrónico al portapapeles" : "Copy email to clipboard"}
          data-tooltip={lang === "es" ? "Copiar email" : "Copy Email"}
          data-copied-text={t.hero.copied}
          class="copy-email-btn-contact flex-1 text-[1.1rem] md:text-[1.2rem] py-3"
        />
        <ButtonGroup
          variant="primary"
          email={email}
          iconLeft="mail"
          iconRight="arrow-right"
          label={t.contact.sendMessage}
          class="flex-1 text-[1.1rem] md:text-[1.2rem] py-3"
        />
      </div>
      <div class="flex flex-wrap gap-2 md:gap-2.5 w-full">
        {social.github && (
          <ButtonGroup variant="outline" href={social.github} target="_blank" rel="noopener" iconLeft="github" label="GitHub" ariaLabel={lang === "es" ? "Ver repositorios en GitHub" : "View GitHub repositories"} class="w-full md:flex-1 min-w-0" />
        )}
        {social.linkedin && (
          <ButtonGroup variant="outline" href={social.linkedin} target="_blank" rel="noopener" iconLeft="linkedin" label="LinkedIn" ariaLabel={lang === "es" ? "Conectar en LinkedIn" : "Connect on LinkedIn"} class="w-full md:flex-1 min-w-0" />
        )}
        <a
          href={cvUrl}
          download="CV_Edgar_Alvarez.pdf"
          data-download-cv
          class="inline-flex items-center justify-center gap-2 font-mono font-bold uppercase text-decoration-none transition-all duration-200 cursor-pointer bg-transparent text-t3 border border-line hover:border-o hover:text-o2 text-[0.8rem] py-2 px-3.5 w-full md:flex-1 min-w-0"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          {t.hero.downloadCV}
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom decorative line -->
  <div class="absolute bottom-0 left-12 right-12 h-px bg-line" aria-hidden="true"></div>
</section>

<style>
  :global(.copy-email-btn-contact) {
    position: relative;
    aspect-ratio: 1;
    width: 52px;
    height: 52px;
    padding: 0 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 52px;
  }

  :global(.copy-email-btn-contact .email-label) {
    display: none;
  }

  :global(.copy-email-btn-contact .icon-mail),
  :global(.copy-email-btn-contact .icon-check) {
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
  }

  :global(.copy-email-btn-contact.copied) {
    background: #16a34a !important;
    box-shadow: 0 0 20px rgba(22, 163, 74, 0.4);
  }

  :global(.copy-email-btn-contact.copied:hover) {
    background: #15803d !important;
  }

  @keyframes iconPopIn {
    0% {
      transform: scale(0) rotate(-90deg);
      opacity: 0;
    }
    40% {
      transform: scale(1.15) rotate(5deg);
      opacity: 1;
    }
    60% {
      transform: scale(0.95) rotate(-2deg);
    }
    75% {
      transform: scale(1.05) rotate(1deg);
    }
    100% {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }
  }

  :global(.copy-email-tooltip) {
    position: fixed;
    transform: translateX(-50%) translateY(0);
    background: #1a1a1a;
    color: #e5e5e5;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 6px 12px;
    border-radius: 0;
    border: 1px solid rgba(249, 115, 22, 0.3);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 9998;
  }

  :global(.copy-email-tooltip::after) {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: #1a1a1a;
  }

  :global(.copy-email-tooltip.show) {
    opacity: 1;
    transform: translateX(-50%) translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.copy-email-btn-contact .icon-mail),
    :global(.copy-email-btn-contact .icon-check) {
      transition: opacity 0.15s ease;
    }
    :global(.copy-email-tooltip) {
      transition: opacity 0.15s ease;
      transform: translateX(-50%) translateY(0);
    }
  }

  :global(.copy-toast) {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #16a34a;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 10px 20px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 8px 30px rgba(22, 163, 74, 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 9999;
  }

  :global(.copy-toast.show) {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.copy-toast) {
      transition: opacity 0.15s ease;
      transform: translateX(-50%) translateY(0);
    }
  }
</style>
