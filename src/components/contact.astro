---
import ButtonGroup from "@/components/button-group.astro";
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";
import { bentoIcons } from "@/data/icon-map";
import GithubIcon from "@/components/icons/github.astro";
import LinkedinIcon from "@/components/icons/linkedin.astro";

interface Props {
  email?: string;
  social?: {
    github?: string;
    linkedin?: string;
    twitter?: string;
  };
  lang: Lang;
}

const { email = "#", social = {}, lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL || '/';
const baseUrl = base.endsWith('/') ? base : `${base}/`;
const cvUrl = `${baseUrl}cv/CV-Edgar-Alvarez-estudiante-ingenieria-en-sistemas.pdf`;

const MailIcon = bentoIcons.mail;
const CvIcon = bentoIcons.cv;
---

<script>
  import "@/scripts/download-cv";
</script>

<section id="contact" class="section-inner py-10 md:py-14">
  <div class="reveal-hidden mb-6 md:mb-8">
    <h2 class="font-big text-[clamp(3.2rem,11vw,7rem)] leading-[0.95] text-t1">
      {t.contact.title} <span class="text-t1">{t.contact.subtitle}</span> <span class="text-o2">{t.contact.highlight}</span>
    </h2>
  </div>

  <article class="bento-card reveal-hidden flex flex-col lg:flex-row gap-6 lg:items-center md:p-8">
    <div class="flex items-start gap-4 flex-1 min-w-0">
      <span class="icon-chip"><MailIcon size={18} /></span>
      <div class="min-w-0">
        <a href={`mailto:${email}`} class="block text-[1.1rem] md:text-[1.35rem] font-semibold text-t1 hover:text-o2 transition-colors break-all">
          {email}
        </a>
      </div>
    </div>
    <div class="flex flex-col gap-2 w-full lg:w-auto lg:shrink-0 lg:min-w-80">
      <div class="flex gap-2 items-stretch">
        <ButtonGroup
          variant="primary"
          size="lg"
          href={`mailto:${email}?subject=${encodeURIComponent(lang === "es" ? "Contacto desde el portfolio" : "Contact from portfolio")}`}
        iconLeft="mail"
        iconRight="arrow-right"
        label={t.contact.sendMessage}
        ariaLabel={lang === "es" ? "Enviar correo electrónico" : "Send email"}
        class="justify-center flex-1"
        />
        <ButtonGroup
          variant="ghost"
          size="lg"
          copyEmail={true}
          email={email}
          iconLeft="mail"
          label={t.hero.copyEmail}
          ariaLabel={lang === "es" ? "Copiar correo electrónico al portapapeles" : "Copy email to clipboard"}
          data-tooltip={lang === "es" ? "Copiar email" : "Copy Email"}
          data-copied-text={t.hero.copied}
          class="copy-email-btn-contact"
        />
      </div>
      <div class="flex gap-2 w-full">
        {social.github && (
          <a href={social.github} target="_blank" rel="noopener" aria-label="GitHub" data-tip="GitHub · @roldyoran" class="icon-chip flex-1 !w-auto !h-14 hover:border-white/25 transition-colors">
            <GithubIcon size={20} />
          </a>
        )}
        {social.linkedin && (
          <a href={social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" data-tip="LinkedIn · Edgar Alvarez" class="icon-chip flex-1 !w-auto !h-14 hover:border-white/25 transition-colors">
            <LinkedinIcon size={20} />
          </a>
        )}
        <a href={cvUrl} data-download-cv aria-label={t.hero.downloadCV} data-tip={t.hero.downloadCV} class="icon-chip flex-1 !w-auto !h-14 hover:border-white/25 transition-colors">
          <CvIcon size={20} />
        </a>
      </div>
    </div>
  </article>
</section>
