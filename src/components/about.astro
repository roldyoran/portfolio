---
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";
import type { SkillWithIcon } from "@/data/types";
import { bentoIcons, aiMonogram } from "@/data/icon-map";

interface Props {
  skillsWithIcons: SkillWithIcon[];
  lang: Lang;
  bio: { text: string; textEs?: string }[];
}

const { skillsWithIcons, lang, bio } = Astro.props;
const t = useTranslations(lang);

const groups: { key: string; iconKey: "backend" | "cloud" | "ai" | "terminal"; match: string[] }[] = [
  { key: "Backend", iconKey: "backend", match: ["Backend", "Language"] },
  { key: "Cloud", iconKey: "cloud", match: ["Cloud", "DevOps", "Database"] },
  { key: "AI", iconKey: "ai", match: ["AI", "Automation"] },
  { key: "Frontend", iconKey: "terminal", match: ["Frontend"] },
];

function skillsFor(match: string[]) {
  return skillsWithIcons.filter((s) => match.includes(s.category)).slice(0, 8);
}
---

<section id="about" class="section-inner py-10 md:py-14">
  <div class="reveal-hidden mb-6 md:mb-8">
    <h2 class="font-big text-[clamp(2.2rem,6vw,4rem)] leading-none text-t1">{t.about.title}</h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 md:gap-4">
    <article class="bento-card reveal-hidden lg:col-span-5 flex flex-col gap-4">
      <span class="font-mono text-[0.85rem] font-bold text-t1 border border-line bg-white/[0.04] rounded-full w-10 h-10 inline-flex items-center justify-center">EA</span>
      {bio.map((paragraph) => (
        <p class="text-[0.95rem] text-t2 leading-relaxed" set:html={lang === "es" && paragraph.textEs ? paragraph.textEs : paragraph.text} />
      ))}
    </article>

    <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
      {groups.map((g) => {
        const GroupIcon = bentoIcons[g.iconKey];
        const items = skillsFor(g.match);
        const isAi = g.key === "AI";
        return (
          <article class:list={["bento-card reveal-hidden flex flex-col gap-3", isAi && "bento-card-accent"]}>
            <div class="flex items-center gap-2.5">
              <span class:list={["icon-chip", isAi && "icon-chip-accent"]}><GroupIcon size={17} /></span>
              <h3 class="font-mono text-[0.68rem] tracking-[0.16em] uppercase text-t1">
                {t.about.categories[g.key] ?? g.key}
              </h3>
            </div>
            <ul class="flex flex-wrap gap-1.5">
              {items.map((skill) => {
                const Icon = skill.icon;
                return (
                  <li class="chip inline-flex items-center gap-1.5" title={skill.name}>
                    {Icon ? (
                      <Icon size={14} class="block h-3.5 w-3.5 opacity-70" />
                    ) : (
                      <span class="w-4 h-4 rounded bg-white/10 text-[0.6rem] flex items-center justify-center text-t1 font-mono">
                        {aiMonogram(skill.name)}
                      </span>
                    )}
                    {skill.name}
                  </li>
                );
              })}
            </ul>
          </article>
        );
      })}
    </div>
  </div>
</section>
