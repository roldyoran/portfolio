---
import GithubIcon from "@/components/icons/github.astro";
import V2Button from "@/components/v2-button.astro";
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { href: "#home", label: t.nav.home },
  { href: "#experience", label: t.nav.work },
  { href: "#projects", label: t.nav.projects },
  { href: "#about", label: t.nav.about },
  { href: "#contact", label: t.nav.contact },
];

const base = import.meta.env.BASE_URL || "/";
const baseUrl = base.endsWith("/") ? base : `${base}/`;
const cvUrl = `${baseUrl}cv/CV-Edgar-Alvarez-estudiante-ingenieria-en-sistemas.pdf`;
const navLabel = lang === "es" ? "Navegación principal" : "Main navigation";
const menuLabel = lang === "es" ? "Menú" : "Menu";
const closeLabel = lang === "es" ? "Cerrar menú" : "Close menu";
---

<header class="v2-header" data-v2-header>
  <nav class="v2-nav" data-v2-nav aria-label={navLabel}>
    <a class="v2-wordmark" href="#home" aria-label="Edgar Alvarez — inicio">
      <span class="v2-wordmark__dot" aria-hidden="true"></span>
      <span>@roldyoran</span>
    </a>
    <span class="v2-nav__pct" id="v2-scroll-pct" aria-hidden="true">00%</span>

    <ul class="v2-nav__menu">
      {
        navLinks.map((item) => (
          <li class="v2-nav__item">
            <a
              class="v2-nav__link"
              href={item.href}
              data-v2-nav-link
              aria-current={item.href === "#home" ? "true" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="v2-nav__utils">
      <a
        class="v2-nav__icon"
        href="https://github.com/roldyoran"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <GithubIcon size={18} />
      </a>
      <V2Button href={cvUrl} variant="outline" target="_blank" rel="noopener">
        {t.hero.downloadCV}
      </V2Button>
      <V2Button href="#contact">{t.nav.hireMe}</V2Button>
    </div>

    <button
      class="v2-burger"
      type="button"
      aria-label={menuLabel}
      aria-expanded="false"
      aria-controls="v2-mobile"
      data-v2-burger
      data-label-closed={menuLabel}
      data-label-open={closeLabel}
    >
      <span class="v2-burger__lines" aria-hidden="true"></span>
    </button>
  </nav>

  <div class="v2-mobile" id="v2-mobile" data-v2-mobile inert>
    <nav class="v2-mobile__nav" aria-label={menuLabel}>
      {
        navLinks.map((item) => (
          <a class="v2-mobile__link" href={item.href} data-v2-mobile-link>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="v2-mobile__ctas">
      <V2Button href={cvUrl} variant="outline" target="_blank" rel="noopener">
        {t.hero.downloadCV}
      </V2Button>
      <V2Button href="#contact">{t.nav.hireMe}</V2Button>
    </div>
  </div>
</header>

<script>
  import { initV2Navbar } from "@/scripts/v2-navbar";

  initV2Navbar();
</script>
