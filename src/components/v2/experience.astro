---
import TechIcon from "@/components/icons/tech-icon.astro";
import IconByName from "@/components/icons/icon-by-name.astro";

interface FakeJob {
  index: string;
  period: string;
  role: string;
  company: string;
  location: string;
  mode: string;
  description: string;
  tech: string[];
  highlights: { value: string; label: string }[];
}

const fakeJobs: FakeJob[] = [
  {
    index: "01",
    period: "2024 — presente",
    role: "Senior Platform Engineer",
    company: "Nebula Cloud Labs",
    location: "Remoto",
    mode: "Tiempo completo",
    description:
      "Lideré la plataforma ficticia de 40 clústeres de Kubernetes: releases canary en Go, remediación con Rust y rightsizing para bajar el coste cloud.",
    tech: ["Kubernetes", "Go", "Rust", "Grafana", "CI/CD"],
    highlights: [
      { value: "99.99%", label: "uptime ficticio" },
      { value: "-38%", label: "coste cloud" },
      { value: "12 s", label: "deploy canary" },
    ],
  },
  {
    index: "02",
    period: "2022 — 2024",
    role: "Backend Engineer",
    company: "Orbit Systems",
    location: "Ciudad Ficción · híbrido",
    mode: "Tiempo completo",
    description:
      "APIs al edge con TypeScript y Hono sobre Cloudflare Workers: caché con Redis, persistencia en Turso y colas para absorber picos de tráfico.",
    tech: ["TypeScript", "Hono", "Cloudflare Workers", "Turso", "Redis"],
    highlights: [
      { value: "<60 ms", label: "p99 edge" },
      { value: "1.2k", label: "req / s" },
      { value: "0", label: "incidentes reales" },
    ],
  },
  {
    index: "03",
    period: "2021 — 2022",
    role: "DevOps Intern",
    company: "Pixel Foundry",
    location: "Remoto",
    mode: "Prácticas",
    description:
      "Dockericé los 38 servicios del estudio y armé pipelines de CI/CD con caché que bajaron los builds a minutos, más el primer monitoreo con Grafana.",
    tech: ["Docker", "Linux", "Git", "Python", "PostgreSQL"],
    highlights: [
      { value: "38", label: "servicios dockerizados" },
      { value: "4.9/5", label: "nota inventada" },
      { value: "∞", label: "café consumido" },
    ],
  },
];
---

<section
  id="experience"
  class="v2-lab relative z-10 overflow-hidden bg-carbon text-cream"
  aria-labelledby="v2-experience-title"
>
  <div class="relative mx-auto w-full max-w-[1140px] px-6 pt-24 pb-14 md:pt-32 md:pb-16 lg:px-16">
    <header
      class="v2-reveal border-b border-cream/15 pb-6"
      data-v2-reveal
    >
      <div>
        <p
          class="inline-flex items-center gap-1 rounded border border-cream/20 px-1.5 py-px font-mono text-[10px] font-medium uppercase tracking-[0.12em] text-cream/70"
        >
          <span class="text-ember">02</span>
          <span aria-hidden="true" class="text-cream/35">·</span>
          Experiencia
        </p>
        <h2
          id="v2-experience-title"
          class="mt-3.5 font-display text-[clamp(28px,3.6vw,46px)] leading-[1.04] tracking-[-0.02em] text-cream"
        >
          Tres roles que <span class="text-cream/55">nunca tuve</span>.
        </h2>
      </div>
    </header>

    <ol
      class="relative m-0 mt-2 list-none p-0 pl-6 before:absolute before:top-2 before:bottom-2 before:left-[7px] before:w-0.5 before:rounded-full before:bg-linear-to-b before:from-cream/55 before:to-cream/[0.06] before:content-[''] md:mt-4 md:pl-8"
    >
      {
        fakeJobs.map((job, index) => (
          <li
            class="v2-reveal group relative transition-colors duration-300 after:absolute after:right-0 after:bottom-0 after:-left-6 after:h-px after:bg-cream/10 after:content-[''] hover:bg-white/[0.04] md:after:-left-8"
            data-v2-reveal
            style={`--reveal-delay:${index * 80}ms`}
          >
            <span
              class="absolute -left-6 top-6 grid size-4 place-items-center transition-transform duration-300 group-hover:scale-110 md:-left-8 md:top-8"
              aria-hidden="true"
            >
              <span
                class={`size-2.5 rounded-full border-2 ${
                  job.index === "01"
                    ? "border-ember bg-ember shadow-[0_0_0_4px_rgb(255_118_28/0.18)]"
                    : "border-cream/70 bg-carbon shadow-[0_0_0_4px_rgb(255_255_255/0.05)]"
                }`}
              />
            </span>

            <article class="grid gap-x-8 gap-y-4 px-2 py-6 sm:px-3 md:grid-cols-[7.5rem_minmax(0,1fr)] md:py-7 lg:grid-cols-[8rem_minmax(0,1fr)_11.5rem]">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 md:flex-col md:items-start md:gap-1.5 md:pt-1">
                <span class="font-mono text-[11px] tracking-[0.2em] text-cream/35 transition-colors group-hover:text-ember">
                  /{job.index}
                </span>
                <span class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-cream">
                  {job.period}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-cream/45">
                  {job.mode}
                </span>
              </div>

              <div class="min-w-0">
                <h3 class="font-display text-[clamp(22px,2.4vw,30px)] leading-[1.06] tracking-[-0.01em] text-cream">
                  {job.role}
                </h3>
                <p class="mt-1.5 font-mono text-[11px] tracking-[0.04em] text-cream/55">
                  <span class="text-cream/85">{job.company}</span>
                  <span aria-hidden="true"> · </span>
                  {job.location}
                </p>

                <p class="mt-3 max-w-[58ch] font-body text-[14px] font-light leading-[1.6] text-cream/70">
                  {job.description}
                </p>

                <ul
                  class="mt-3.5 flex flex-wrap items-center gap-x-4 gap-y-1.5"
                  aria-label={`Tecnologías en ${job.company}`}
                >
                  {job.tech.map((label) => (
                    <li class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.1em] text-cream/50 transition-colors group-hover:text-cream/75">
                      <TechIcon name={label} size={13} />
                      {label}
                    </li>
                  ))}
                </ul>
              </div>

              <dl
                class="grid grid-cols-3 gap-3 border-t border-cream/10 pt-4 sm:gap-4 md:col-start-2 lg:col-start-3 lg:grid-cols-1 lg:gap-0 lg:divide-y lg:divide-cream/10 lg:border-t-0 lg:border-l lg:border-cream/10 lg:pt-0 lg:pl-6"
              >
                {job.highlights.map((item) => (
                  <div class="flex flex-col-reverse lg:py-2 lg:first:pt-1 lg:last:pb-1">
                    <dt class="mt-1 font-mono text-[9px] uppercase leading-snug tracking-[0.12em] text-cream/45">
                      {item.label}
                    </dt>
                    <dd class="font-display text-[21px] leading-none tracking-[-0.01em] text-cream/90 tabular-nums">
                      {item.value}
                    </dd>
                  </div>
                ))}
              </dl>
            </article>
          </li>
        ))
      }
    </ol>

    <footer
      class="v2-reveal mt-7 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center"
      data-v2-reveal
    >
      <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-cream/40">
        Sección de prueba · todo es ficticio
      </p>
      <a
        href="#home"
        class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-cream/60 transition-colors hover:text-cream"
      >
        Volver arriba
        <IconByName name="arrow-up-right" size={13} />
      </a>
    </footer>
  </div>
</section>

<noscript>
  <style>
    .v2-reveal {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<script>
  import { initV2Experience } from "@/scripts/v2/experience";

  initV2Experience();
</script>
