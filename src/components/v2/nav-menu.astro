---
import {
  NavigationMenu,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
} from "@/components/starwind/navigation-menu";

export interface NavItem {
  href: `#${string}`;
  label: string;
}

interface Props {
  items: NavItem[];
  label: string;
  orientation?: "horizontal" | "vertical";
  /** Marks the section that is active on first paint; the navbar script keeps it in sync. */
  activeHref?: `#${string}`;
  /** Closes the Starwind Sheet that hosts the menu (mobile drawer). */
  closeOnNavigate?: boolean;
  class?: string;
}

const {
  items,
  label,
  orientation = "horizontal",
  activeHref,
  closeOnNavigate = false,
  class: className,
} = Astro.props;

const isVertical = orientation === "vertical";

const rootClass = [
  "flex-none",
  isVertical ? "w-full justify-start" : "ml-auto justify-end max-[1079px]:hidden",
  className,
]
  .filter(Boolean)
  .join(" ");

const listClass = isVertical ? "w-full flex-col items-stretch" : undefined;
const linkClass = isVertical ? "w-full p-3 text-base" : "px-3 py-2";
---

<NavigationMenu size="sm" orientation={orientation} aria-label={label} class={rootClass}>
  <NavigationMenuList class={listClass}>
    {
      items.map((item) => (
        <NavigationMenuItem>
          <NavigationMenuLink
            href={item.href}
            active={item.href === activeHref}
            data-v2-nav-link={isVertical ? undefined : ""}
            data-sw-drawer-close={closeOnNavigate ? "" : undefined}
            class:list={[linkClass, "group/link"]}
          >
            <span
              class:list={[
                "relative transition-colors duration-300",
                "group-hover/link:text-(--v2-nav-hover) group-focus-visible/link:text-(--v2-nav-hover)",
                "after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:origin-center after:scale-x-0",
                "after:bg-(--v2-nav-hover) after:transition-all after:duration-300 after:ease-site after:content-['']",
                "group-hover/link:after:scale-x-100 group-focus-visible/link:after:scale-x-100",
              ]}
            >
              {item.label}
            </span>
          </NavigationMenuLink>
        </NavigationMenuItem>
      ))
    }
  </NavigationMenuList>
</NavigationMenu>
