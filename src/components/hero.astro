---
import HeroLogos from "@/components/hero-logos.astro";
import IconByName from "@/components/icons/icon-by-name.astro";
import type { Hero } from "@/data/types";
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";

interface Props {
  hero: Hero;
  lang: Lang;
  logosLabel: string;
  logoItems: string[];
}

const { hero, lang, logosLabel, logoItems } = Astro.props;
const t = useTranslations(lang);
const summary = lang === "es" ? hero.descriptionEs : hero.description;
---

<script>
  import { initPortfolioHero } from "@/scripts/portfolio-hero";

  initPortfolioHero();
</script>

<section id="home" class="ph-hero" data-ph-hero aria-labelledby="ph-title">
  <canvas class="ph-hero__particles" data-ph-particles aria-hidden="true"></canvas>

  <div class="ph-hero__inner">
    <h1 class="ph-hero__title ph-anim" id="ph-title" style="--d: 0.05s">
      <span>{hero.namePrimary}</span>
      <span class="ph-hero__title-soft">{hero.nameAccent}</span>
    </h1>

    <p class="ph-hero__sub ph-anim" style="--d: 0.38s">
      {summary}
    </p>

    <div class="ph-hero__ctas ph-anim" style="--d: 0.5s">
      <a class="ph-hero__cta" href="#contact">
        {t.hero.contactMe}
        <IconByName name="arrow-up-right" size={16} />
      </a>
    </div>

    <div class="ph-hero__logos ph-anim" style="--d: 0.6s">
      <HeroLogos items={logoItems} />
      <p class="sr-only">{logosLabel}</p>
    </div>
  </div>
</section>

<style>
  .ph-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: clamp(7rem, 18vh, 11rem);
    overflow: hidden;
    border-bottom-right-radius: 48px;
    border-bottom-left-radius: 48px;
    background: var(--color-ink);
    color: var(--color-cream);
  }

  .ph-hero__particles {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    color: var(--color-cream);
    opacity: 0;
    pointer-events: none;
    transition: opacity 1s ease;
    -webkit-mask-image:
      linear-gradient(to bottom, #000 0, #000 58%, transparent 100%),
      linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to bottom, #000 0, #000 58%, transparent 100%),
      linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
    mask-composite: intersect;
  }

  .ph-hero__particles.is-ready {
    opacity: 1;
  }

  .ph-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    width: min(1100px, 100% - 3rem);
    margin: 0 auto;
    padding-bottom: 2rem;
  }

  .ph-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 13vw, 11rem);
    line-height: 0.95;
    letter-spacing: 0.01em;
  }

  .ph-hero__title > span {
    display: block;
  }

  .ph-hero__title-soft {
    color: var(--color-soft-ink);
  }

  .ph-hero__sub {
    max-width: 44rem;
    margin: 1.5rem 0 0;
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.375rem);
    line-height: 1.6;
    color: var(--color-cream);
  }

  .ph-hero__ctas {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }

  .ph-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.75rem;
    border-radius: var(--radius-md);
    background: var(--color-ember);
    color: var(--color-ink);
    /* Regla de marca: los CTA “Contáctame / Contact Me” siempre van en mono. */
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.88rem;
    text-decoration: none;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .ph-hero__cta:hover {
    background: var(--color-ember-hover);
    transform: translateY(-1px);
  }

  .ph-hero__cta:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 3px;
  }

  .ph-hero__logos {
    margin-top: 3.5rem;
    padding-bottom: 3rem;
  }

  .ph-anim {
    opacity: 0;
    animation: ph-hero-in 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
  }

  @keyframes ph-hero-in {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ph-anim {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
