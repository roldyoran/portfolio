---
import ButtonGroup from "@/components/button-group.astro";
import type { Hero } from "@/data/types";
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";

interface Props {
  hero: Hero;
  marquee: string[];
  linkedin?: string;
  github?: string;
  email?: string;
  lang: Lang;
  githubStats?: {
    repos: number;
    followers: number;
    contributions: number;
    yearsExp: number;
  };
}

const { hero, linkedin = "#", github = "#", email = "#", lang, githubStats } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL || "/";
const baseUrl = base.endsWith("/") ? base : `${base}/`;
const cvUrl = `${baseUrl}cv/CV_Edgar_Alvarez.pdf`;

const yearsCount = githubStats?.yearsExp ?? (parseInt(hero.years, 10) || 0);
const reposCount = githubStats?.repos || 0;
const contributionsCount = githubStats?.contributions || 0;
const followersCount = githubStats?.followers || 0;

const tagline =
  lang === "es" && hero.taglineEs
    ? hero.taglineEs.replace("{years}", hero.years).replace("{focus}", hero.focus ?? hero.products)
    : hero.tagline.replace("{years}", hero.years).replace("{focus}", hero.focus ?? hero.products);
---

<script>
  import "@/scripts/hero-motion";
  import "@/scripts/download-cv";
  import { initNeuralGrid } from "@/scripts/neural-grid";

  initNeuralGrid("#neural-canvas");
</script>

<section
  id="home"
  class="hero-section relative min-h-[50vh] lg:min-h-[60vh] grid grid-rows-[1fr_auto] py-6 md:py-8 border-b border-line overflow-hidden"
>
  <canvas id="neural-canvas" class="hero-canvas"></canvas>

  <div class="container-page">
    <div
      class="hero-content relative z-10 flex flex-col lg:grid lg:grid-cols-[40%_1fr] lg:items-center pb-2 md:pb-4 pt-0 gap-0"
    >
    <div class="hero-left shrink-0">
      <div
        class="hero-eyebrow font-mono text-[0.8rem] text-o tracking-widest mb-2 md:mb-3 py-1.5 inline-block rounded"
      >
        [{hero.index}] — {lang === "es" && hero.roleEs ? hero.roleEs : hero.role} s
      </div>
      <h1
        class="hero-title font-big text-[clamp(48px,10vw,115px)] leading-[0.92] tracking-[-0.02em] text-t1 mb-2 md:mb-3 text-shadow-sm"
      >
        <span class="hero-name-primary">
          {hero.namePrimary}
        </span>
        <em class="text-o block">
          <span class="hero-name-accent">
            {hero.nameAccent}
          </span>.
        </em>
      </h1>
      <p
        class="hero-deck font-mono text-[0.82rem] text-t2 leading-7 border-l-2 border-o pl-4 max-w-80"
        set:html={tagline}
      />
    </div>

    <div
      class="hero-right flex flex-col justify-end gap-3 md:gap-4"
    >
      <p class="hero-description text-[0.88rem] md:text-[0.92rem] text-t2 leading-relaxed">
        {lang === "es" && hero.descriptionEs ? hero.descriptionEs : hero.description}
      </p>
      <div class="hero-cta w-full flex flex-col gap-2">
        <div class="flex gap-2 w-full">
          <ButtonGroup
            variant="primary"
            copyEmail={true}
            email={email}
            iconLeft="mail"
            label={t.hero.copyEmail}
            ariaLabel={lang === "es" ? "Copiar correo electrónico al portapapeles" : "Copy email to clipboard"}
            data-tooltip={lang === "es" ? "Copiar email" : "Copy Email"}
            data-copied-text={t.hero.copied}
            class="copy-email-btn-hero"
          />
          <ButtonGroup
            variant="primary"
            href={`mailto:${email}`}
            iconLeft="mail"
            iconRight="arrow-right"
            label={t.hero.contactMe}
            class="flex-1 text-[1.05rem] md:text-[1.1rem] py-2.5"
          />
        </div>
        <div class="flex flex-wrap gap-2 w-full items-center">
          <ButtonGroup
            variant="ghost"
            href={linkedin}
            target="_blank"
            rel="noopener"
            iconLeft="linkedin"
            label={t.hero.linkedin}
            ariaLabel={lang === "es" ? "Conectar en LinkedIn" : "Connect on LinkedIn"}
            class="w-full md:flex-1 min-w-0 text-[0.7rem] md:text-[0.75rem]"
          />
          <ButtonGroup
            variant="ghost"
            href={github}
            target="_blank"
            rel="noopener"
            iconLeft="github"
            label={t.hero.github}
            ariaLabel={lang === "es" ? "Ver perfil de GitHub" : "View GitHub profile"}
            class="w-full md:flex-1 min-w-0 text-[0.7rem] md:text-[0.75rem]"
          />
          <a
            href={cvUrl}
            data-download-cv
            class="inline-flex items-center justify-center gap-2 font-mono font-bold uppercase text-decoration-none transition-all duration-200 cursor-pointer bg-transparent text-t2 border border-line hover:border-o hover:text-o2 text-[0.7rem] md:text-[0.75rem] py-2.5 px-[22px] flex-1 w-full justify-center"
          >
            <span class="icon-download">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
                  points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"
                ></line></svg
              >
            </span>
            {t.hero.downloadCV}
          </a>
        </div>
      </div>
    </div>
  </div>
  </div>

  <div class="container-page">
    <div
      class="hero-meta grid grid-cols-2 lg:grid-cols-4 items-stretch border-t border-line relative z-10"
    >
    <div
      class="hero-stat stat-card p-3 md:p-4 border-b lg:border-b-0 lg:border-r border-line transition-colors duration-300 hover:bg-bg2"
    >
      <dl>
        <dt class="sr-only">{t.hero.yearsExp}</dt>
        <dd class="font-big text-[1.4rem] md:text-[1.8rem] text-o2 leading-none mb-0.5">
          <span class="stat-number" data-count={yearsCount} data-suffix="+">0</span>
        </dd>
      </dl>
      <div class="font-mono text-[0.6rem] md:text-[0.62rem] text-t3 tracking-widest uppercase">
        {t.hero.yearsExp}
      </div>
    </div>
    <div
      class="hero-stat stat-card p-3 md:p-4 border-b lg:border-b-0 lg:border-r border-line transition-colors duration-300 hover:bg-bg2"
    >
      <dl>
        <dt class="sr-only">{t.hero.productsShipped}</dt>
        <dd class="font-big text-[1.4rem] md:text-[1.8rem] text-o2 leading-none mb-0.5">
          <span class="stat-number" data-count={reposCount}>0</span>
        </dd>
      </dl>
      <div class="font-mono text-[0.6rem] md:text-[0.62rem] text-t3 tracking-widest uppercase">
        {t.hero.productsShipped}
      </div>
    </div>
    <div
      class="hero-stat stat-card p-3 md:p-4 border-b lg:border-b-0 lg:border-r border-line transition-colors duration-300 hover:bg-bg2"
    >
      <dl>
        <dt class="sr-only">{t.hero.contributions}</dt>
        <dd class="font-big text-[1.4rem] md:text-[1.8rem] text-o2 leading-none mb-0.5">
          <span class="stat-number" data-count={contributionsCount} data-suffix="+">0</span>
        </dd>
      </dl>
      <div class="font-mono text-[0.6rem] md:text-[0.62rem] text-t3 tracking-widest uppercase">
        {t.hero.contributions}
      </div>
    </div>
    <div
      class="hero-stat stat-card p-3 md:p-4 border-b lg:border-b-0 border-line transition-colors duration-300 hover:bg-bg2"
    >
      <dl>
        <dt class="sr-only">{t.hero.followers}</dt>
        <dd class="font-big text-[1.4rem] md:text-[1.8rem] text-o2 leading-none mb-0.5">
          <span class="stat-number" data-count={followersCount}>0</span>
        </dd>
      </dl>
      <div class="font-mono text-[0.6rem] md:text-[0.62rem] text-t3 tracking-widest uppercase">
        {t.hero.followers}
      </div>
    </div>
  </div>
</div>
</section>

<style is:global>
  .copy-email-btn-hero {
    position: relative;
    aspect-ratio: 1;
    width: 48px;
    height: 48px;
    padding: 0 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 48px;
  }

  .copy-email-btn-hero .email-label {
    display: none;
  }

  .copy-email-btn-hero.copied {
    background: #16a34a !important;
    box-shadow: 0 0 20px rgba(22, 163, 74, 0.4);
  }

  .copy-email-btn-hero.copied:hover {
    background: #15803d !important;
  }

  .hero-eyebrow {
    --load-order: 1;
  }
  .hero-title {
    --load-order: 2;
  }
  .hero-deck {
    --load-order: 3;
  }
  .hero-description {
    --load-order: 4;
  }
  .hero-cta {
    --load-order: 5;
  }
  .hero-stat:nth-child(1) {
    --load-order: 6;
  }
  .hero-stat:nth-child(2) {
    --load-order: 7;
  }
  .hero-stat:nth-child(3) {
    --load-order: 8;
  }
  .hero-stat:nth-child(4) {
    --load-order: 9;
  }

  .hero-eyebrow,
  .hero-title,
  .hero-deck,
  .hero-description,
  .hero-cta,
  .hero-stat {
    opacity: 0;
    animation: hero-fade-in 0.9s cubic-bezier(0.25, 0.1, 0.25, 1) calc(var(--load-order) * 0.1s)
      forwards;
  }

  @keyframes hero-fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 82% 78% at 50% 52%, #000 28%, transparent 92%);
    mask-image: radial-gradient(ellipse 82% 78% at 50% 52%, #000 28%, transparent 92%);
    z-index: 0;
  }

  noscript .hero-eyebrow,
  noscript .hero-title,
  noscript .hero-deck,
  noscript .hero-description,
  noscript .hero-cta,
  noscript .hero-stat {
    opacity: 1 !important;
    transform: none !important;
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-title,
    .hero-deck,
    .hero-description,
    .hero-cta,
    .hero-stat {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
