---
import V2Layout from "@/layouts/v2-layout.astro";
import V2Navbar from "@/components/v2/navbar.astro";
import V2Hero from "@/components/v2/hero.astro";
import V2Experience from "@/components/v2/experience.astro";
import V2ScrollStudy from "@/components/v2/scroll-study.astro";
import config, { heroLogoLabels } from "@/data/content";

const title = "Edgar Alvarez — Portfolio v2 (borrador)";
const description =
  "Borrador v2 del portafolio de Edgar Alvarez: diseño full dark con navbar, hero y una sección de experiencia en tonos oscuros y acento naranja.";
const logosLabel = "Tecnologías";
---

<V2Layout title={title} description={description} lang="es">
  <V2Navbar lang="es" />

  <main id="v2-main">
    <V2Hero
      hero={config.hero}
      lang="es"
      logosLabel={logosLabel}
      logoItems={heroLogoLabels}
    />

    <V2Experience />

    <V2ScrollStudy />
  </main>
</V2Layout>
